def ts(ad,m=[],y=0,x=0,b=1):
    sert=serial_open("COM")
    k = '00'+['W','R'][bool(y)]+'SB06%DW'
    k = [ord(i) for i in k]
    n = len(m) if not y else y*x
    ad = [0]*(3-len(str(ad))) + list(map(int,str(ad)))
    k +=[ord(str(abs(i))) for i in ad]
    k +=[ord(i) for i in '{:02X}'.format(n)]
    if not y:
        for i in m:
            if i < 0:
                i += 2**16
            k += [ord(j) for j in '{:04X}'.format(i)]
    sert.write([5]+k+[4])
    wait(0.1 if n is 1 else 0.1)
    k=sert.read(sert.inWaiting())
    serial_close(sert)
    if y:
        for i in range(0,y*x*4,4):
            v = int(k[10+i:14+i],16)
            if v&(1<<15):
                v -= 2**16
            m.append(v)
        return m if len(m) > 1 else m[0]
def wer(*a,b=1):
    if isinstance(a[0],int):
        a = [a]
    for i,j in a:
        ts(i,j if isinstance(j,list) else [j],b=b)
def read(ad,y=1,x=1):
    return ts(ad,[],y,x)
import heapq
import time

drl_report_line(0)

begin_blend(30)
set_velx(700),set_accx(700)
set_velj(50),set_accj(50)

h= posj(90, 0, 90, 90, 90, 0)
a=posx(52.89, 359.12, 230.32, 0, -90, -90)
bu=posj(30.28, 6.85, 110.3, 104.92, 63.34, -30.71)
b = posx(321.98, 316.23, 220.05, 90, 90, 90)

def tplog(d):
    tp_log(str(d))

def grip(n):
    if n == True:
        wait(0.5)
        set_tool_digital_outputs([1,-2])
        wait(0.5)
    else:
        wait(0.5)
        set_tool_digital_outputs([-1,2])
        wait(0.5)
        
def pos(pos,x,y):
    li = [pos]
    for i in range(1,x*y):
        if i%x == 0:
            li.append(trans(li[i-x],[0,40,0,0,0,0]))
        else:
            li.append(trans(li[i-1],[-40,0,0,0,0,0]))
    return li


def up(pos,n):
    return trans(pos,[0,0,n,0,0,0])

def srh(m):
    global n
    res = []
    if m not in n:
        n[m] = [i for i in range(9) if m[i]!='0']
    for i in n[m]:
        q=[i]
        r={i:[i]}
        for cur in q:
            for j in aro[cur]:
                if j in q or m[j]!='0':
                    continue
                q.append(j)
                r[j] = r[cur] + [j]
                cm = list(m)
                cm[j],cm[i] = cm[i],cm[j]
                res.append([''.join(cm),[r[j],int(m[i])]])
    return res

def hg(m,em):
    res = 0
    for i in range(len(m)):
        if m[i] != '0':
            j = em.index(m[i])
            sx,sy = (i//x, i%x)
            ex,ey = (j//x, j%x)
            res += abs(sx-ex) + abs(sy-ey)
    return res

def main():
    global x,y,aro,n
    sm,em = ''.join(map(str,read(1,9))), ''.join(map(str,read(10,9)))
    
    x,y = 3,3
    aro = ((3,1),(4,2,0),(5,1),(6,4,0),(7,5,1,3),(8,2,4),(7,3),(8,4,6),(5,7))
    n = {}
    ol = [(hg(sm, em), 0, sm)]
    cl = {sm:0}
    par = {}

    while ol:
        f, g, cur = heapq.heappop(ol)
        if cl[cur] != g:
            continue
        if cur == em:
            path = []
            while cur != sm:
                s,e = par[cur]
                path.append([cur,e])
                cur = s
            path.reverse()
            return path
        ng = g + 1
        for cm,st in srh(cur):
            if cm not in cl:
                cl[cm] = ng
                par[cm] = (cur,st)
                heapq.heappush(ol, (hg(cm, em) + ng, ng, cm))

    return None

def A():
    p = pos(a,3,3)
    ap = main()
    for i in ap:
        tplog(i)
        s,e = i[1][0][0],i[1][0][-1]
        movel(up(p[s],70))
        movel(p[s])
        grip(1)
        hmi = read(1,9)
        hmi[hmi.index(i[1][1])] = 0
        wer(1,hmi)
        for j in i[1][0]:
            movel(up(p[j],5))
            if j == e:
                movel(up(p[j],5),r=0)
        movel(p[e])
        grip(0)
        wer(1,list(map(int,i[0])))
        movel(up(p[e],100))

grip(0)
movej(h)   
A()
movej(bu)
movel(b)
