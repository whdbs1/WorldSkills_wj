# -------------------------
# 카메라 통신
# -------------------------

def send(data):
    req = urllib.request.Request(
        "http://{}:{}".format(ip, port),
        data=json.dumps(data).encode(),
        headers={"Content-Type": "application/json"}
    )

    resp = urllib.request.urlopen(req)

    return json.loads(
        resp.read().decode("utf-8")
    )


def cam(command):
    if command == "colors":
        ok, result = send(["get_colors"])

    elif command == "dist":
        ok, result = send(["get_distance"])

    else:
        return None

    if ok == True:
        return result

    return None


def printf(value):
    tp_log("{}".format(value))


# -------------------------
# 시작
# -------------------------

grip(False)

movel(h)
wait(2)
movel(s2)

normal_index = 0
blue_index = 0

# 총 6개 물체 처리
for i in range(12):

    # 카메라 위치로 이동
    movel(s2)
    movel(cmr)

    wait(0.5)

    # 색 확인
    colors = cam("colors")
    printf(colors)

    # 아무것도 없으면 바로 홈으로 가고 종료
    if colors is None or len(colors) == 0:
        printf("No color detected")
        movel(h)
        break

    # 색이 있을 때만 다시 s2로 이동
    movel(s2)

    # 여기부터 물체 잡기
    movel(s1)
    grip(True)

    movel(s2)


    # -------------------------
    # 4. 파란색이면 blue_pos
    # -------------------------

    if colors is None or len(colors) == 0:

        printf("No color detected")
        movel(h)
    
    elif "Blue" in colors:
    
        printf("Blue detected")
    
        target = blue_positions[blue_index]
    
        movel(up(target, 80))
        movel(target)
    
        grip(False)
    
        movel(up(target, 80))
    
        blue_index = blue_index + 1
    
    else:
    
        printf("Normal detected")
    
        target = normal_positions[normal_index]
    
        movel(up(target, 80))
        movel(target)
    
        grip(False)
    
        movel(up(target, 80))
    
        normal_index = normal_index + 1

    # -------------------------
    # 6. 다음 물체 확인하러 복귀
    # -------------------------

    movel(s2)


# -------------------------
