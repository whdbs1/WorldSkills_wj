import urllib.request
import json


ip = "192.168.137.10"
port = "8080"


set_velx(100)
set_accx(1000)


def tplog(d):
    tp_log(str(d))

def grip(n):
    if n == True:
        wait(0.5)
        set_tool_digital_outputs([1,-2])
        wait(0.5)
    else:
        wait(0.5)
        set_tool_digital_outputs([-1,2])
        wait(0.5)
        
def pos(pos,x,y):
    li = [pos]
    for i in range(1,x*y):
        if i%x == 0:
            li.append(trans(li[i-x],[0,40,0,0,0,0]))
        else:
            li.append(trans(li[i-1],[-40,0,0,0,0,0]))
    return li


def up(pos,n):
    return trans(pos,[0,0,n,0,0,0])


# -------------------------
# 위치
# -------------------------

h = posx(-127.25, 368, 546, 0, -90, -90)
p1 = 

p1 = posx(175.74, 491.24, 233.98, 180, 90, 90)
p2 = posx(135.74, 491.24, 233.98, 180, 90, 90)
